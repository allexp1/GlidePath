// GlidePath build configuration.
//
// SETUP: copy this file to Config.xcconfig and fill in the four values below.
//
//     cp Config.example.xcconfig Config.xcconfig
//
// Config.xcconfig is gitignored. This example file is the only one committed.
// ios/project.yml wires Config.xcconfig into every build configuration, and the
// values land in Info.plist, where Sources/Configuration/AppConfig.swift reads
// them at runtime.

// ---------------------------------------------------------------------------
// Supabase - from your project dashboard, Settings > API
// ---------------------------------------------------------------------------

// Your project host, WITHOUT the https:// prefix.
//
// No scheme on purpose. An xcconfig file treats "//" as the start of a comment
// wherever it appears, so writing https://abc.supabase.co would silently
// truncate to "https:" and the app would refuse to start. Leaving the scheme
// off avoids the problem entirely; the app adds https for you.
//
// Just the project ref on its own works too, e.g. SUPABASE_URL = abcdefghijklm
SUPABASE_URL = YOUR-PROJECT-REF.supabase.co

// The anon / publishable key. Safe to ship in a client binary: every table is
// protected by row level security (see supabase/migrations). It grants public
// read on camera data and insert-only on pending_reports.
SUPABASE_ANON_KEY = YOUR-ANON-KEY

// ---------------------------------------------------------------------------
// Apple - from developer.apple.com, Membership details
// ---------------------------------------------------------------------------

// Your 10-character Team ID, e.g. A1B2C3D4E5
DEVELOPMENT_TEAM = YOUR-TEAM-ID

// Reverse-DNS bundle identifier. Must be unique across the App Store, so
// change this to something you own before you try to run on a device.
PRODUCT_BUNDLE_IDENTIFIER = ai.glidepath.app

// ---------------------------------------------------------------------------
// Signing - leave as-is for normal development
// ---------------------------------------------------------------------------

CODE_SIGN_STYLE = Automatic
