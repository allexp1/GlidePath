# ---- Secrets (the only files you edit by hand) ----
Config.xcconfig
supabase/.env
.env
.env.local

# ---- Xcode ----
# The Xcode project is generated by XcodeGen from ios/project.yml, so nothing
# under *.xcodeproj is committed. Run `make project` to regenerate it.
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
build/
*.xcuserstate
*.xcscmblueprint
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# ---- Swift Package Manager ----
.build/
.swiftpm/
Package.resolved

# ---- Supabase ----
supabase/.branches/
supabase/.temp/

# ---- Node / Deno tooling for seeds ----
node_modules/
npm-debug.log*
deno.lock

# ---- Seed output / scratch ----
supabase/seed/out/
*.osm.json

# ---- macOS ----
.DS_Store
.AppleDouble
.LSOverride

# Resume checkpoints written by seed_limits.ts.
supabase/seed/.limits-*.json

# Generated by XcodeGen from ios/project.yml, alongside the project itself.
ios/App/Info.plist
